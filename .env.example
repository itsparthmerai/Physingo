# Copy this file to .env and fill in the values from your Firebase project.
# See docs/CLOUD_SYNC_SETUP.md for step-by-step instructions.
#
# These EXPO_PUBLIC_ variables are inlined into the app bundle at build time
# (Expo's standard mechanism for client-exposed config - see app config docs).
# Firebase's web config values are meant to be public; they're not secret keys.
# Keeping them out of git is still good hygiene, which is why .env is gitignored.

# Firebase project config (Project settings -> General -> Your apps -> Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Firebase Console -> Authentication -> Sign-in method -> Google).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is required for Google sign-in on any platform (web sign-in
# uses it directly; native falls back to it too). iOS/Android client IDs are optional extras for
# a native (EAS/dev-client) build - see the setup doc for why they're needed for a reliable native flow.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
